
# CACU03: ¿Qué ponderación se usa en cada observación acústica?

PREFIX edintacus: <https://edint.es/def/contaminacion-acustica#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?obs ?ponderation ?label
WHERE {
  ?obs a edintacus:NoiseObservation ;
       edintacus:noisePonderation ?ponderation .
  OPTIONAL { ?ponderation rdfs:label ?label }
}
