
# CACU09: ¿Qué información completa tiene cada observación acústica?

PREFIX edintacus: <https://edint.es/def/contaminacion-acustica#>

SELECT ?obs ?emitter ?ponderation ?rateType ?interval ?timeConstant
WHERE {
  ?obs a edintacus:NoiseObservation .
  OPTIONAL { ?obs edintacus:noiseEmitterPredominantType ?emitter }
  OPTIONAL { ?obs edintacus:noisePonderation ?ponderation }
  OPTIONAL { ?obs edintacus:noiseRateType ?rateType }
  OPTIONAL { ?obs edintacus:noiseReferenceInterval ?interval }
  OPTIONAL { ?obs edintacus:noiseTimeConstantType ?timeConstant }
}