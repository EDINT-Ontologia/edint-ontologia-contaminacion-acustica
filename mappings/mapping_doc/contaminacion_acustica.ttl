<observation_laeq_0> a rr:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source "contaminacion_acustica_normalizado.csv";
		rml:referenceFormulation ql:CSV

	];
	rr:subjectMap [
		a rr:SubjectMap;
		rr:template "https://example.org/recurso/observacionAcustica/{entityid}/{dateobserved}/laeq";
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rdf:type;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant edintacus:NoiseObservation;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant dct:date;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "dateobserved";
			rr:datatype xsd:date
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant edintacus:noisePonderation;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant edintnoisepon:A;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:observedProperty;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant edintkos-vars:StatisticalNoiseLevels;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:madeBySensor;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/sensorAcustico/{entityid}";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:resultTime;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "recvtime";
			rr:datatype xsd:dateTime
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant dct:identifier;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "{entityid}-{dateobserved}";
			rr:termType rr:Literal
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant sosa:hasResult;
		];
		rr:objectMap [
			a rr:RefObjectMap;
			rr:parentTriplesMap <result_laeq_0>;

		]
	].


