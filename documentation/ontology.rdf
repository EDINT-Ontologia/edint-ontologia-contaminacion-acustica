     xmlns:vocab="https://w3id.org/widoco/vocab#"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="https://edint.es/def/contaminacion-acustica">
        <owl:versionIRI rdf:resource="https://edint.es/def/contaminacion-acustica/0.2.1"/>
        <owl:imports rdf:resource="https://edint.es/def/medioambiente#"/>
        <terms:abstract xml:lang="es">Esta ontología intenta proporcionar el vocabulario común para representar las principales entidades y datos de sensores y observaciones sobre contaminación acústica. Es una actualización de una &lt;a href=&quot;https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio/index-en.html&quot;&gt;versión previa&lt;/a&gt; de la ontología, que adapta esa ontología para cubrir los requisitos del Espacio de Datos para las Infraestructuras Urbanas Inteligentes &lt;a href=&quot;https://edint.es/&quot;&gt;(EDINT)&lt;/a&gt;. También amplia la &lt;a href=&quot;http://vocab.linkeddata.es/datosabiertos/def/medioambiente/&quot;&gt;ontología de medioambiente&lt;/a&gt; para el caso de la contaminación acústica.</terms:abstract>
        <terms:abstract xml:lang="en">This ontology aims to provide the commun vocabulary for representing the main entities and data for sensors and observations on noise pollution. It is an update of a &lt;a href=&quot;https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio/index-en.html&quot;&gt;previous version&lt;/a&gt;, which adapts that ontology to comply with &lt;a href=&quot;https://edint.es/&quot;&gt;(EDINT)&lt;/a&gt; requirements. It also extends the &lt;a href=&quot;http://vocab.linkeddata.es/datosabiertos/def/medioambiente/&quot;&gt;Environmental Sensors Ontology&lt;/a&gt; for noise pollution. </terms:abstract>
        <terms:bibliographicCitation xml:lang="en">EDINT Noise Pollution Ontology. EDINT. Revision: v0.2.1.</terms:bibliographicCitation>
        <terms:bibliographicCitation xml:lang="es">Ontología EDINT de Contaminación Acústica. EDINT. Revisión: v0.2.1.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-27</terms:created>
        <terms:creator rdf:nodeID="genid1"/>
        <terms:creator rdf:nodeID="genid2"/>
        <terms:creator rdf:nodeID="genid3"/>
        <terms:creator rdf:nodeID="genid4"/>
        <terms:creator rdf:nodeID="genid5"/>
        <terms:description xml:lang="en">A lightweight ontology extending the medioambiente EDIT Ontology to represent noise pollution, restricting their observations to the EDINT SKOS controlled vocabulary.</terms:description>
        <terms:description xml:lang="es">Una ontología ligera que extiende la ontología EDINT de medioambiente para representar contaminación acústica, restringiendo sus mediciones al vocabulario controlado SKOS de EDINT.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</terms:modified>
        <terms:publisher rdf:nodeID="genid6"/>
        <terms:title xml:lang="en">EDINT Noise Pollution Ontology</terms:title>
        <terms:title xml:lang="es">Ontología EDINT de Contaminación Acústica</terms:title>
        <vann:preferredNamespacePrefix>edintacus</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://edint.es/def/contaminacion-acustica#"/>
        <schema:codeRepository rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-contaminacion-acustica"/>
        <schema:creativeWorkStatus xml:lang="en">Ontology Specification</schema:creativeWorkStatus>
        <schema:funding>Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)</schema:funding>
        <rdfs:label xml:lang="es">Contaminación Acústica</rdfs:label>
        <rdfs:label xml:lang="en">Noise Pollution</rdfs:label>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-contaminacion-acustica/releases/tag/v0.2.0"/>
        <owl:versionInfo>0.2.1</owl:versionInfo>
        <vocab:jsonldSerialization>ontology.jsonld</vocab:jsonldSerialization>
        <vocab:ntSerialization>ontology.nt</vocab:ntSerialization>
        <vocab:rdfxmlSerialization>ontology.rdf</vocab:rdfxmlSerialization>
        <vocab:turtleSerialization>ontology.ttl</vocab:turtleSerialization>
        <vocab:vocabularyLabel rdf:nodeID="genid7"/>
    </owl:Ontology>
