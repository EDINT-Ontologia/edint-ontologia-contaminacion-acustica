    <!-- http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/noiseEmitterPredominantType -->


    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/noiseEmitterPredominantType">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/NoiseObservation"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="http://vocab.linkeddata.es/datosabiertos/kos/edint/NoiseEmitterPredominantType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Property that links a noise observation to its predominant type of emitter.</rdfs:comment>
        <rdfs:comment xml:lang="es">Propiedad que vincula una observación de ruido a su tipo predominante de emisor</rdfs:comment>
        <rdfs:label xml:lang="en">pedominant type of noise emitter</rdfs:label>
        <rdfs:label xml:lang="es">tipo de emisor de ruido predominante</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/noisePonderation -->


    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/noisePonderation">
