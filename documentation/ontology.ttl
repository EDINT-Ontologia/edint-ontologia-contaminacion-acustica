###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class ;
                                              rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core#> .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class ;
                                                    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core#> .


###  https://edint.es/def/contaminacion-acustica#NoiseObservation
:NoiseObservation rdf:type owl:Class ;
                  rdfs:subClassOf <https://edint.es/def/medioambiente#EnvironmentalObservation> ;
                  rdfs:comment "An observation of a noise property made by a noise sensor"@en ,
                               "Una observación de una propiedad acústica realizada por un sensor acústico"@es ;
                  rdfs:label "Noise observation"@en ,
                             "Observación acústica"@es .


###  https://edint.es/def/medioambiente#EnvironmentalObservation
<https://edint.es/def/medioambiente#EnvironmentalObservation> rdf:type owl:Class ;
                                                              rdfs:isDefinedBy <https://edint.es/def/medioambiente#> .


