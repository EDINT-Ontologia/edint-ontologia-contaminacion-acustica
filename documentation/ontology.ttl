<https://edint.es/def/contaminacion-acustica> rdf:type owl:Ontology ;
                                               owl:versionIRI <https://edint.es/def/contaminacion-acustica/0.2.1> ;
                                               owl:imports <https://edint.es/def/medioambiente#> ;
                                               <http://purl.org/dc/terms/abstract> "Esta ontología intenta proporcionar el vocabulario común para representar las principales entidades y datos de sensores y observaciones sobre contaminación acústica. Es una actualización de una <a href=\"https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio/index-en.html\">versión previa</a> de la ontología, que adapta esa ontología para cubrir los requisitos del Espacio de Datos para las Infraestructuras Urbanas Inteligentes <a href=\"https://edint.es/\">(EDINT)</a>. También amplia la <a href=\"http://vocab.linkeddata.es/datosabiertos/def/medioambiente/\">ontología de medioambiente</a> para el caso de la contaminación acústica."@es ,
                                                                                   "This ontology aims to provide the commun vocabulary for representing the main entities and data for sensors and observations on noise pollution. It is an update of a <a href=\"https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio/index-en.html\">previous version</a>, which adapts that ontology to comply with <a href=\"https://edint.es/\">(EDINT)</a> requirements. It also extends the <a href=\"http://vocab.linkeddata.es/datosabiertos/def/medioambiente/\">Environmental Sensors Ontology</a> for noise pollution. "@en ;
                                               <http://purl.org/dc/terms/bibliographicCitation> "EDINT Noise Pollution Ontology. EDINT. Revision: v0.2.1."@en ,
                                                                                                "Ontología EDINT de Contaminación Acústica. EDINT. Revisión: v0.2.1."@es ;
                                               <http://purl.org/dc/terms/created> "2026-03-27"^^xsd:date ;
                                               <http://purl.org/dc/terms/creator> _:genid1 ,
                                                                                  _:genid2 ,
                                                                                  _:genid3 ,
                                                                                  _:genid4 ,
                                                                                  _:genid5 ;
                                               <http://purl.org/dc/terms/description> "A lightweight ontology extending the medioambiente EDIT Ontology to represent noise pollution, restricting their observations to the EDINT SKOS controlled vocabulary."@en ,
                                                                                      "Una ontología ligera que extiende la ontología EDINT de medioambiente para representar contaminación acústica, restringiendo sus mediciones al vocabulario controlado SKOS de EDINT."@es ;
                                               <http://purl.org/dc/terms/issued> "2026-09-14"^^xsd:date ;
                                               <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                               <http://purl.org/dc/terms/modified> "2026-09-14"^^xsd:date ;
                                               <http://purl.org/dc/terms/publisher> _:genid6 ;
                                               <http://purl.org/dc/terms/title> "EDINT Noise Pollution Ontology"@en ,
                                                                                "Ontología EDINT de Contaminación Acústica"@es ;
                                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "edintacus" ;
                                               <http://purl.org/vocab/vann/preferredNamespaceUri> : ;
                                               rdfs:label "Contaminación Acústica"@es ,
                                                          "Noise Pollution"@en ;
                                               owl:priorVersion <https://github.com/EDINT-Ontologia/edint-ontologia-contaminacion-acustica/releases/tag/v0.2.0> ;
                                               owl:versionInfo "0.2.1" ;
                                               <https://schema.org/codeRepository> <https://github.com/EDINT-Ontologia/edint-ontologia-contaminacion-acustica> ;
                                               <https://schema.org/creativeWorkStatus> "Ontology Specification"@en ;
                                               <https://schema.org/funding> "Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)" ;
                                               <https://w3id.org/widoco/vocab#jsonldSerialization> "ontology.jsonld" ;
                                               <https://w3id.org/widoco/vocab#ntSerialization> "ontology.nt" ;
                                               <https://w3id.org/widoco/vocab#rdfxmlSerialization> "ontology.rdf" ;
                                               <https://w3id.org/widoco/vocab#turtleSerialization> "ontology.ttl" ;
                                               <https://w3id.org/widoco/vocab#vocabularyLabel> _:genid7 .

