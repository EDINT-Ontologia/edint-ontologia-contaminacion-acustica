###  http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/noiseEmitterPredominantType
:noiseEmitterPredominantType rdf:type owl:ObjectProperty ;
                             rdfs:domain :NoiseObservation ;
                             rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                                 owl:hasValue <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoiseEmitterPredominantType>
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                             rdfs:comment "Property that links a noise observation to its predominant type of emitter."@en ,
                                          "Propiedad que vincula una observación de ruido a su tipo predominante de emisor"@es ;
                             rdfs:label "pedominant type of noise emitter"@en ,
                                        "tipo de emisor de ruido predominante"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/noisePonderation
:noisePonderation rdf:type owl:ObjectProperty ;
                  rdfs:domain :NoiseObservation ;
                  rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                      owl:hasValue <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoisePonderation>
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
                  rdfs:comment "Property that links a noise observation to its weighting."@en ,
                               "Propiedad que vincula una observación de ruido  a su ponderación."@es ;
                  rdfs:label "noise ponderation"@en ,
                             "ponderación de ruido"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/noiseRateType
:noiseRateType rdf:type owl:ObjectProperty ;
               rdfs:domain :NoiseObservation ;
               rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                   owl:hasValue <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoiseRateType>
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
               rdfs:comment "Property that links a noise observation to its type of level for noise pressure level."@en ,
                            "Propiedad que vincula una observación acústica con su tipo de índice para el nivel de presión sonora."@es ;
               rdfs:label "tipo de índice para ruido"@es ,
                          "type of rate for noise pressure level"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/noiseReferenceInterval
:noiseReferenceInterval rdf:type owl:ObjectProperty ;
                        rdfs:domain :NoiseObservation ;
                        rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                            owl:hasValue <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoiseReferenceInterval>
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
                        rdfs:comment "Property that links a noise observation to its measurement period"@en ,
                                     "Propiedad que  vincula una observación de ruido a su periodo de medición"@es ;
                        rdfs:label "intervalo de referencia para ruido"@es ,
                                   "noise reference interval"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/noiseTimeConstantType
:noiseTimeConstantType rdf:type owl:ObjectProperty ;
                       rdfs:domain :NoiseObservation ;
                       rdfs:range [ owl:intersectionOf ( <http://www.w3.org/2004/02/skos/core#Concept>
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                                           owl:hasValue <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoiseTimeConstantType>
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                       rdfs:comment "Property that links a noise observation to its type of time constant."@en ,
                                    "Propiedad que vincula una observación de ruido a su tipo de constante de tiempo."@es ;
                       rdfs:label "tipo de constante de tiempo para el ruido"@es ,
