}, {
  "@id" : "https://edint.es/def/contaminacion-acustica",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "es",
    "@value" : "Esta ontología intenta proporcionar el vocabulario común para representar las principales entidades y datos de sensores y observaciones sobre contaminación acústica. Es una actualización de una <a href=\"https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio/index-en.html\">versión previa</a> de la ontología, que adapta esa ontología para cubrir los requisitos del Espacio de Datos para las Infraestructuras Urbanas Inteligentes <a href=\"https://edint.es/\">(EDINT)</a>. También amplia la <a href=\"http://vocab.linkeddata.es/datosabiertos/def/medioambiente/\">ontología de medioambiente</a> para el caso de la contaminación acústica."
  }, {
    "@language" : "en",
    "@value" : "This ontology aims to provide the commun vocabulary for representing the main entities and data for sensors and observations on noise pollution. It is an update of a <a href=\"https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio/index-en.html\">previous version</a>, which adapts that ontology to comply with <a href=\"https://edint.es/\">(EDINT)</a> requirements. It also extends the <a href=\"http://vocab.linkeddata.es/datosabiertos/def/medioambiente/\">Environmental Sensors Ontology</a> for noise pollution. "
  } ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "EDINT Noise Pollution Ontology. EDINT. Revision: v0.2.1."
  }, {
    "@language" : "es",
    "@value" : "Ontología EDINT de Contaminación Acústica. EDINT. Revisión: v0.2.1."
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-03-27"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "_:genid1"
  }, {
    "@id" : "_:genid2"
  }, {
    "@id" : "_:genid3"
  }, {
    "@id" : "_:genid4"
  }, {
    "@id" : "_:genid5"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "A lightweight ontology extending the medioambiente EDIT Ontology to represent noise pollution, restricting their observations to the EDINT SKOS controlled vocabulary."
  }, {
    "@language" : "es",
    "@value" : "Una ontología ligera que extiende la ontología EDINT de medioambiente para representar contaminación acústica, restringiendo sus mediciones al vocabulario controlado SKOS de EDINT."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-09-14"
  } ],
