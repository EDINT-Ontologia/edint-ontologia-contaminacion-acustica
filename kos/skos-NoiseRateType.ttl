@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintmed: <http://vocab.linkeddata.es/datosabiertos/def/medioambiente/> .
@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .

@prefix edintnoiseratetype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoiseRateType/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edintkos:NoiseRateType a skos:ConceptScheme ; 
    dct:issued "2026-03-27"^^xsd:date ;
    dct:modified "2026-03-27"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
    rdfs:label "Type of rate for sound pressure level"@en ;
    rdfs:label "Tipo de índice para el nivel de presión sonora"@es ;
    dct:title "Concept scheme grouping types of rate for sound pressure level"@en ;
    dct:title "Esquema de conceptos que agrupa tipos de índice para el nivel de presión sonora"@es ;
    skos:note "Values currently based on the list of values included in http://vocab.linkeddata.es/datosabiertos/kos/medio-ambiente/contaminacion-acustica/tipo-medicion-acustica"@en ;
    skos:note "Valores basados inicialmente en la lista de valores de http://vocab.linkeddata.es/datosabiertos/kos/medio-ambiente/contaminacion-acustica/tipo-medicion-acustica"@es .



#################################################################
#
#    Concepts
#
#################################################################

edintnoiseratetype:max a skos:Concept ;
  skos:inScheme edintkos:NoiseRateType ;
  skos:notation: "max" ;
  skos:prefLabel "maximum"@en ;
  skos:prefLabel "máximo"@es ;
  skos:definition "Nivel de presión sonora máximo"@es ;
  skos:definition "Maximum sound pressure level"@en .
  
edintnoiseratetype:min a skos:Concept ;
  skos:inScheme edintkos:NoiseRateType ;
  skos:prefLabel "minimum"@en ;
  skos:prefLabel "mínimo"@es ;
  skos:definition "Nivel de presión sonora mínimo"@es ;
  skos:definition "Minimum sound pressure level"@en .

#### Percentiles considerados: 01, 10, 50, 90, 99. Se pueden añadir los percentiles extra necesarios .

edintnoiseratetype:01 a skos:Concept ;
  skos:inScheme edintkos:NoiseRateType ;
  skos:notation: "01" ;
  skos:prefLabel "Percentil 01"@es ;
  skos:prefLabel "01st percentile "@en ;
  skos:definition "Nivel de presión sonora que se sobrepasa durante el 1% del tiempo de observación"@es ;
  skos:definition "Sound pressure level exceeded for 1% of the observation time"@en .

edintnoiseratetype:10 a skos:Concept ;
  skos:inScheme edintkos:NoiseRateType ;
  skos:notation: "10" ;
  skos:prefLabel "Percentil 10"@es ;
  skos:prefLabel "10th percentile"@en ;
  skos:definition "Nivel de presión sonora que se sobrepasa durante el 10% del tiempo de observación"@es ;
  skos:definition "Sound pressure level exceeded for 10% of the observation time"@en .

edintnoiseratetype:50 a skos:Concept ;
  skos:inScheme edintkos:NoiseRateType ;
  skos:notation: "50" ;
  skos:prefLabel "Percentil 50"@es ;
  skos:prefLabel "50th percentile"@en ;
  skos:definition "Nivel de presión sonora que se sobrepasa durante el 50% del tiempo de observación"@es ;
  skos:definition "Sound pressure level exceeded for 50% of the observation time"@en .

edintnoiseratetype:90 a skos:Concept ;
  skos:inScheme edintkos:NoiseRateType ;
  skos:notation: "90" ;
  skos:prefLabel "Percentil 90"@es ;
  skos:prefLabel "90th percentile"@en ;
  skos:definition "Nivel de presión sonora que se sobrepasa durante el 90% del tiempo de observación"@es ;
  skos:definition "Sound pressure level exceeded for 90% of the observation time"@en .

edintnoiseratetype:99 a skos:Concept ;
  skos:inScheme edintkos:NoiseRateType ;
  skos:notation: "99" ;
  skos:prefLabel "Percentil 99"@es ;
  skos:prefLabel "99th percentile"@en ;
  skos:definition "Nivel de presión sonora que se sobrepasa durante el 99% del tiempo de observación"@es ;
  skos:definition "Sound pressure level exceeded for 99% of the observation time"@en .
