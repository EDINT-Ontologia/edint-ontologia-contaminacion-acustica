@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintmed: <http://vocab.linkeddata.es/datosabiertos/def/medioambiente/> .
@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .

@prefix edintnoisepon: <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoisePonderation/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edintkos:NoisePonderation a skos:ConceptScheme ; 
    dct:issued "2026-03-27"^^xsd:date ;
    dct:modified "2026-03-27"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
    rdfs:label "Type of time constant for sound pressure level measurement, i.e., how quickly the equipment responds to changes in sound."@en ;
    rdfs:label "Tipo de constante de tiempo para medición del nivel de presión sonora, es decir, cómo de rápido responde el equipo a los cambios del sonido."@es ;
    dct:title "Conceptual scheme grouping the ponderation for sound pressure level"@en ;
    dct:title "Esquema de conceptos que agrupa la poderación para el nivel de presión sonora"@es .



#################################################################
#
#    Concepts
#
#################################################################

edintnoisemeaspeed:A a skos:Concept ;
  skos:inScheme edintkos:NoisePonderation ;
  skos:notation: "A" ;
  skos:prefLabel "Ponderación A"@es ;
  skos:prefLabel "A weighting"@en ;
  skos:definition "Ponderación ajustada a la sensibilidad del oído humano"@es ;
  skos:definition "Weighting adjusted to the sensitivity of the human ear." @en .
  
edintnoisemeaspeed:C a skos:Concept ;
  skos:inScheme edintkos:NoisePonderation ;
  skos:notation: "C" ;
  skos:prefLabel "C weighting"@es ;
  skos:prefLabel "Ponderación C"@en ;
  skos:definition "Ponderación que apenas atenúa las bajas frecuencias. Representa mejor sonidos de alta intensidad"@es ;
  skos:definition "Weighting that barely attenuates low frequencies. It represents high-intensity sounds better."@en .