    <!-- https://edint.es/def/contaminacion-acustica#NoiseObservation -->

    <owl:Class rdf:about="https://edint.es/def/contaminacion-acustica#NoiseObservation">
        <rdfs:subClassOf rdf:resource="https://edint.es/def/medioambiente#EnvironmentalObservation"/>
        <rdfs:comment xml:lang="en">An observation of a noise property made by a noise sensor</rdfs:comment>
        <rdfs:comment xml:lang="es">Una observación de una propiedad acústica realizada por un sensor acústico</rdfs:comment>
        <rdfs:label xml:lang="en">Noise observation</rdfs:label>
        <rdfs:label xml:lang="es">Observación acústica</rdfs:label>
    </owl:Class>
    


