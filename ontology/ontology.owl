     xmlns:widoco="https://w3id.org/widoco/vocab#">    <owl:Ontology rdf:about="https://edint.es/def/contaminacion-acustica">
        <owl:versionIRI rdf:resource="https://edint.es/def/contaminacion-acustica/0.2.1"/>
