        <dct:description xml:lang="en">A lightweight ontology extending the medioambiente EDIT Ontology to represent noise pollution, restricting their observations to the EDINT SKOS controlled vocabulary.</dct:description>
        <dct:description xml:lang="es">Una ontología ligera que extiende la ontología EDINT de medioambiente para representar contaminación acústica, restringiendo sus mediciones al vocabulario controlado SKOS de EDINT.</dct:description>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-27</dct:issued>
        <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-27</dct:modified>
        <dct:title xml:lang="en">EDINT Noise Pollution Ontology</dct:title>
        <dct:title xml:lang="es">Ontología EDINT de Contaminación Acústica</dct:title>
        <vann:preferredNamespacePrefix rdf:resource="https://edint.es/def/contaminacion-acustica#"/>
        <vann:preferredNamespacePrefix>edintacus</vann:preferredNamespacePrefix>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-contaminacion-acustica/releases/tag/v0.2.0"/>
        <owl:versionInfo>0.2.1</owl:versionInfo>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-27</dcterms:created>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</dcterms:issued>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</dcterms:modified>
        <dcterms:publisher rdf:parseType="Resource">
            <foaf:name>FEMP</foaf:name>
            <foaf:homepage rdf:resource="https://www.femp.es/"/>
            <schema:affiliation>Federación Española de Municipios y Provincias</schema:affiliation>
        </dcterms:publisher>
    <dcterms:bibliographicCitation xml:lang="es">Ontología EDINT de Contaminación Acústica. EDINT.</dcterms:bibliographicCitation>
    <schema:creativeWorkStatus xml:lang="en">Ontology Specification</schema:creativeWorkStatus>
    <dcterms:abstract xml:lang="es">Esta ontología intenta proporcionar el vocabulario común para representar las principales entidades y datos de sensores y observaciones sobre contaminación acústica. Es una actualización de una &lt;a href="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio/index-en.html"&gt;versión previa&lt;/a&gt; de la ontología, que adapta esa ontología para cubrir los requisitos del Espacio de Datos para las Infraestructuras Urbanas Inteligentes &lt;a href="https://edint.es/"&gt;(EDINT)&lt;/a&gt;. También amplia la &lt;a href="http://vocab.linkeddata.es/datosabiertos/def/medioambiente/"&gt;ontología de medioambiente&lt;/a&gt; para el caso de la contaminación acústica.</dcterms:abstract>
    <dcterms:abstract xml:lang="en">This ontology aims to provide the commun vocabulary for representing the main entities and data for sensors and observations on noise pollution. It is an update of a &lt;a href="https://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio/index-en.html"&gt;previous version&lt;/a&gt;, which adapts that ontology to comply with &lt;a href="https://edint.es/"&gt;(EDINT)&lt;/a&gt; requirements. It also extends the &lt;a href="http://vocab.linkeddata.es/datosabiertos/def/medioambiente/"&gt;Environmental Sensors Ontology&lt;/a&gt; for noise pollution. </dcterms:abstract>
</owl:Ontology>
    <foaf:Organization rdf:about="https://oeg.fi.upm.es/">
        <foaf:name>Ontology Engineering Group, UPM</foaf:name>
    </foaf:Organization>
    


