    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/contaminacion-acustica#noiseEmitterPredominantType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/contaminacion-acustica#noiseEmitterPredominantType">
        <rdfs:domain rdf:resource="https://edint.es/def/contaminacion-acustica#NoiseObservation"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/NoiseEmitterPredominantType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Property that links a noise observation to its predominant type of emitter.</rdfs:comment>
        <rdfs:comment xml:lang="es">Propiedad que vincula una observación de ruido a su tipo predominante de emisor</rdfs:comment>
        <rdfs:label xml:lang="en">pedominant type of noise emitter</rdfs:label>
        <rdfs:label xml:lang="es">tipo de emisor de ruido predominante</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/contaminacion-acustica#noisePonderation -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/contaminacion-acustica#noisePonderation">
        <rdfs:domain rdf:resource="https://edint.es/def/contaminacion-acustica#NoiseObservation"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/NoisePonderation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Property that links a noise observation to its weighting.</rdfs:comment>
        <rdfs:comment xml:lang="es">Propiedad que vincula una observación de ruido  a su ponderación.</rdfs:comment>
        <rdfs:label xml:lang="en">noise ponderation</rdfs:label>
        <rdfs:label xml:lang="es">ponderación de ruido</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/contaminacion-acustica#noiseRateType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/contaminacion-acustica#noiseRateType">
        <rdfs:domain rdf:resource="https://edint.es/def/contaminacion-acustica#NoiseObservation"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/NoiseRateType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Property that links a noise observation to its type of level for noise pressure level.</rdfs:comment>
        <rdfs:comment xml:lang="es">Propiedad que vincula una observación acústica con su tipo de índice para el nivel de presión sonora.</rdfs:comment>
        <rdfs:label xml:lang="es">tipo de índice para ruido</rdfs:label>
        <rdfs:label xml:lang="en">type of rate for noise pressure level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/contaminacion-acustica#noiseReferenceInterval -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/contaminacion-acustica#noiseReferenceInterval">
        <rdfs:domain rdf:resource="https://edint.es/def/contaminacion-acustica#NoiseObservation"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/NoiseReferenceInterval"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Property that links a noise observation to its measurement period</rdfs:comment>
        <rdfs:comment xml:lang="es">Propiedad que  vincula una observación de ruido a su periodo de medición</rdfs:comment>
        <rdfs:label xml:lang="es">intervalo de referencia para ruido</rdfs:label>
        <rdfs:label xml:lang="en">noise reference interval</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/contaminacion-acustica#noiseTimeConstantType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/contaminacion-acustica#noiseTimeConstantType">
        <rdfs:domain rdf:resource="https://edint.es/def/contaminacion-acustica#NoiseObservation"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/NoiseTimeConstantType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Property that links a noise observation to its type of time constant.</rdfs:comment>
        <rdfs:comment xml:lang="es">Propiedad que vincula una observación de ruido a su tipo de constante de tiempo.</rdfs:comment>
        <rdfs:label xml:lang="es">tipo de constante de tiempo para el ruido</rdfs:label>
        <rdfs:label xml:lang="en">type of noise time constant</rdfs:label>
    </owl:ObjectProperty>
    


