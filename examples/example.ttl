@prefix edintmed: <http://vocab.linkeddata.es/datosabiertos/def/medioambiente/> .
@prefix edintkosvars: <http://vocab.linkeddata.es/datosabiertos/kos/edint/EnvironmentalProperty/> .
@prefix edintkosfoi: <http://vocab.linkeddata.es/datosabiertos/kos/edint/foi/> .
@prefix edintkossentype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/sensortypes/> .

@prefix edintacus <http://vocab.linkeddata.es/datosabiertos/def/contaminacionacustica/> .
@prefix edintemittertype <http://vocab.linkeddata.es/datosabiertos/kos/edint/EmitterPredominantType/> .
@prefix edintnoiseratetype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoiseRateType/> .
@prefix edintnoiserefint: <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoiseReferenceInterval/> .
@prefix edintnoisetimecon: <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoiseTimeConstantType/> .
@prefix edintnoiseratetype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoiseRateType/> .
@prefix edintnoisepon: <http://vocab.linkeddata.es/datosabiertos/kos/edint/NoisePonderation/> .


@prefix ex: <http://example.org/> .


# ---------------------------------------------------------------------------
# ESTACION ACUSTICA
# ---------------------------------------------------------------------------

ex:Noise_Station_001 a edintmed:SensorPlatform ;
    rdfs:label "Estación de monitorización acústica - Plaza Mayor"@es ;
    rdfs:label "Acoustic monitoring station - Plaza Mayor"@en ;
    dct:identifier "ACOUSTIC-001-MAD" ;
    geo:lat "40.4153"^^xsd:float ;
    geo:long "-3.7074"^^xsd:float ;
    geo:alt "635"^^xsd:float ;
    rdfs:comment "Estación urbana fija para monitorización de niveles de ruido ambiental"@es ;
    rdfs:comment "Fixed urban station for environmental noise level monitoring"@en ;
    gsp:hasGeometry [
        a gsp:Geometry ;
        gsp:asWKT "POINT(-3.7074 40.4153)"^^xsd:string .
    ].

# ---------------------------------------------------------------------------
# SENSORES
# ---------------------------------------------------------------------------

ex:Noise_Sensor_001 a edintmed:EnvironmentalSensor ;
    rdfs:label "Sensor acústico 1"@es ;
    rdfs:label "Noise sensor 1"@en ;
    dct:identifier "NOISE-001" ;
    schema:manufacturer ex:Manufacturer_001 ;
    edintmed:hasSensorType edintkossentype:NoiseSensor ;
    sosa:isHostedBy ex:Noise_Station_001 ;
    sosa:observes edintkosvars:SoundPressureLevel .

ex:Noise_Sensor_002 a edintmed:EnvironmentalSensor ;
    rdfs:label "Sensor acústico 2"@es ;
    rdfs:label "Noise sensor 2"@en ;
    dct:identifier "NOISE-002" ;
    schema:manufacturer ex:Manufacturer_001 ;
    edintmed:hasSensorType edintkossentype:NoiseSensor ;
    sosa:isHostedBy ex:Noise_Station_001 ;
    sosa:observes edintkosvars:SoundPressureLevel .

# ---------------------------------------------------------------------------
# OBSERVACIONES - 18/03/2026
# ---------------------------------------------------------------------------

# Medición del nivel de presión sonora equivalente con ponderación A y vehiculo automóvil como emisor preponderante

ex:Observation_LAeq_001 a edintacus:NoiseObservation ;
    dct:identifier ex:Medicion_001	# Identificador compartido entre todos los valores calculados para una misma medición				
	edintacus:noiseReferenceInterval edintnoiserefint:EquivalentLevel ;
	edintacus:noisePonderation edintnoisepon:A ;
	edintacus:noiseEmitterPredominantType edintemittertype:motorvehicle ;
	rdfs:label "Nivel de presión sonora equivalente con ponderación A - 18/03/2026 08:00"@es ;
    rdfs:label "A-weighting equivalent noise pressure level - 18/03/2026 08:00"@en ;
    sosa:madeBySensor ex:Noise_Sensor_001 ;
    sosa:hasFeatureOfInterest edintkosfoi:AcousticEnvironment ; 
    sosa:resultTime "2026-03-18T08:00:00+01:00"^^xsd:dateTime ;
    sosa:hasResult [
        a qudt:QuantityValue ;
        qudt:numericValue "57.4"^^xsd:decimal ;
        qudt:unit unit:DeciB
    ] .

# Medición del nivel de presión sonora con ponderación A, constante lenta y percentil 10 para periodos diurnos
 
ex:Observation_LAS10_001 a edintacus:NoiseObservation ;
    dct:identifier ex:Medicion_001	# Identificador compartido entre todos los valores calculados para una misma medición				
	edintacus:noiseReferenceInterval edintnoiserefint:Day ;
	edintacus:noisePonderation edintnoisepon:A ;
	edintnoisetimecon:Slow ;
	edintnoiseratetype:10 ;
	edintacus:noiseEmitterPredominantType edintemittertype:motorvehicle ;
	rdfs:label "Nivel de presión sonora que delimita el percentil 10 con ponderación A y constante de tiempo lenta- 18/03/2026 08:00"@es ;
    rdfs:label "A-weighting and slow-time-constant 10th percentile noise pressure level - 18/03/2026 08:00"@en ;
    sosa:madeBySensor ex:Noise_Sensor_001 ;
    sosa:hasFeatureOfInterest edintkosfoi:AcousticEnvironment ; 
    sosa:resultTime "2026-03-18T08:00:00+01:00"^^xsd:dateTime ;
    sosa:hasResult [
        a qudt:QuantityValue ;
        qudt:numericValue "66.6"^^xsd:decimal ;
        qudt:unit unit:DeciB
    ] .


